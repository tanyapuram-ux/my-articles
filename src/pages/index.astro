---
import FeaturedIn from '../components/FeaturedIn.astro';

const categories = ['Entrepreneurship & Business', 'Founder Interviews', 'Tech & AI'];
const categoryDetails = {
	'Entrepreneurship & Business': { slug: 'entrepreneurship', description: 'Lessons from starting, growing, and building companies.' },
	'Founder Interviews': { slug: 'founder-interviews', description: 'Conversations with the people shaping companies.' },
	'Tech & AI': { slug: 'tech-ai', description: 'Notes on technology, tools, and the future of work.' },
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Essays and conversations about building what matters." />
		<meta name="generator" content={Astro.generator} />
		<title>Tanya Puram | Writing on entrepreneurship and AI</title>
	</head>
	<body>
		<header class="site-header">
			<nav class="nav-group nav-left" aria-label="Primary navigation">
				<a class="site-name" href="/">Home</a>
				<a href="/analytics/">Analytics</a>
				<a href="/featured/">Featured In</a>
				<a href="https://medium.com/@tanya.puram" target="_blank" rel="noopener noreferrer">Medium Blog</a>
			</nav>
			<nav class="nav-group nav-right" aria-label="Secondary navigation">
				<a href="/articles/entrepreneurship/">Entrepreneurship &amp; Business</a>
				<a href="/articles/founder-interviews/">Founder Interviews</a>
				<a href="/articles/tech-ai/">Tech &amp; AI</a>
			</nav>
		</header>

		<main>
			<section class="intro" aria-labelledby="page-title">
				<p class="eyebrow">Writer, entrepreneur, and researcher</p>
				<h1 id="page-title">I write about<br /><em>entrepreneurship, founders, and AI.</em></h1>
				<div class="cta-row">
					<a class="primary-button" href="/featured/">View recognition</a>
					<a class="secondary-button" href="/articles/founder-interviews/">Read my best work</a>
				</div>
			</section>

			<FeaturedIn />

			<div class="category-cards">
				{categories.map((category, index) => (
					<a class="category-card" href={`/articles/${categoryDetails[category].slug}/`}>
						<span class="category-index">0{index + 1}</span>
						<div>
							<h2>{category}</h2>
							<p>{categoryDetails[category].description}</p>
						</div>
						<span class="card-arrow" aria-hidden="true">↗</span>
					</a>
				))}
			</div>
		</main>

		<footer>
			<span>My Articles</span>
			<span>© {new Date().getFullYear()}</span>
		</footer>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=DM+Serif+Display:ital@0;1&display=swap');

	:global(*) { box-sizing: border-box; }
	:global(body) {
		margin: 0;
		background: #f5f3ef;
		color: #20231f;
		font-family: 'DM Sans', sans-serif;
	}
	.site-header, main, footer { width: min(1120px, calc(100% - 64px)); margin-inline: auto; }
	.site-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 28px 0;
		border-bottom: 1px solid #d9d8d2;
		gap: 24px;
	}
	.nav-group {
		display: flex;
		align-items: center;
		gap: 24px;
		flex-wrap: wrap;
	}
	.nav-right { justify-content: flex-end; }
	.site-name { color: inherit; font-size: 1rem; font-weight: 700; letter-spacing: 0; text-decoration: none; }
	nav a { color: #70736d; font-size: 0.74rem; letter-spacing: 0.04em; text-decoration: none; }
	nav a:hover, .category-card:hover h2 { color: #52705d; }
	.eyebrow, .category-index, footer { color: #70736d; font-size: 0.74rem; letter-spacing: 0.08em; }
	.intro { padding: 112px 0 128px; max-width: 760px; }
	.eyebrow { margin: 0 0 24px; text-transform: uppercase; }
	h1, h2, h3, p { margin-top: 0; }
	h1 { margin-bottom: 28px; font-family: 'DM Serif Display', Georgia, serif; font-size: clamp(3.3rem, 7vw, 6.8rem); font-weight: 400; letter-spacing: 0; line-height: 0.96; }
	h1 em { color: #52705d; }
	.intro-copy { max-width: 480px; color: #5f625d; font-size: 1.05rem; line-height: 1.7; }
	.cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
	.primary-button, .secondary-button { display: inline-flex; align-items: center; justify-content: center; padding: 0.85rem 1.2rem; border: 1px solid #20231f; border-radius: 999px; font-size: 0.85rem; font-weight: 700; text-decoration: none; transition: transform 180ms ease, background 180ms ease; }
	.primary-button { background: #20231f; color: #f5f3ef; }
	.secondary-button { background: transparent; color: #20231f; }
	.primary-button:hover, .secondary-button:hover { transform: translateY(-2px); }
	.category-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
	.category-card { position: relative; display: flex; min-height: 250px; flex-direction: column; justify-content: space-between; padding: 24px; border: 1px solid #bfc2b9; color: inherit; text-decoration: none; transition: background 180ms ease, transform 180ms ease; }
	.category-card:hover { background: #ebeae4; transform: translateY(-4px); }
	.category-index { margin: 0; color: #52705d; }
	.category-card h2 { margin: 0 0 12px; font-family: 'DM Serif Display', Georgia, serif; font-size: 2rem; font-weight: 400; line-height: 1.05; transition: color 180ms ease; }
	.category-card p { max-width: 230px; margin: 0; color: #686b65; font-size: 0.9rem; line-height: 1.55; }
	.card-arrow { align-self: flex-end; color: #52705d; font-size: 1.5rem; }
	footer { display: flex; justify-content: space-between; padding: 28px 0 42px; text-transform: uppercase; }
	@media (max-width: 700px) {
		.site-header, main, footer { width: min(100% - 40px, 560px); }
		.site-header { flex-direction: column; align-items: flex-start; }
		.nav-group { gap: 12px; }
		.nav-right { justify-content: flex-start; }
		nav a { font-size: 0.72rem; }
		.intro { padding: 78px 0 88px; }
		h1 { font-size: clamp(3rem, 15vw, 5rem); }
		.category-cards { grid-template-columns: 1fr; }
		.category-card { min-height: 190px; }
	}
</style>
