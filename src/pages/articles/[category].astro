---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const categorySlugs = {
		'entrepreneurship': 'Entrepreneurship & Business',
		'founder-interviews': 'Founder Interviews',
		'tech-ai': 'Tech & AI',
	};
	return Object.entries(categorySlugs).map(([slug, category]) => ({ params: { category: slug }, props: { category } }));
}

const { category } = Astro.props;
const articles = (await getCollection('articles', ({ data }) => data.category === category))
	.sort((first, second) => second.data.date.valueOf() - first.data.date.valueOf())
	.map((article) => ({
		...article,
		pinned: article.id === 'founder-interviews/maya-chen',
	}))
	.sort((first, second) => {
		if (first.pinned && !second.pinned) return -1;
		if (!first.pinned && second.pinned) return 1;
		return second.data.date.valueOf() - first.data.date.valueOf();
	});
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={`${category} articles from My Articles.`} />
		<title>{category} | My Articles</title>
	</head>
	<body>
		<header class="site-header">
			<nav class="nav-group nav-left" aria-label="Primary navigation">
				<a class="site-name" href="/">Home</a>
				<a href="/analytics/">Analytics</a>
				<a href="/featured/">Featured In</a>
				<a href="https://medium.com/@tanya.puram" target="_blank" rel="noopener noreferrer">Medium Blog</a>
			</nav>
			<nav class="nav-group nav-right" aria-label="Secondary navigation">
				<a href="/articles/founder-interviews/">Founder Interviews</a>
				<a href="/articles/entrepreneurship/">Entrepreneurship &amp; Business</a>
				<a href="/articles/tech-ai/">Tech &amp; AI</a>
			</nav>
		</header>
		<main>
			<a class="return-link" href="/">← Back home</a>
			<p class="eyebrow">Article collection</p>
			<h1>{category}</h1>
			<div class="article-list">
				{articles.map((article) => (
					<article class:list={{ pinned: article.pinned }}>
						{article.data.coverImage && <img class="article-cover" src={article.data.coverImage} alt={`${article.data.title} cover`} />}
						<div class="article-content">
							<div class="meta"><time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time><span aria-hidden="true">/</span><span>{category}</span>{article.pinned && <span class="pinned-badge">Pinned</span>}</div>
							<h2>
								<a href={article.data.url} target="_blank" rel="noopener noreferrer">{article.data.title}</a>
							</h2>
							<p>{article.data.description}</p>
							<a class="read-link" href={article.data.url} target="_blank" rel="noopener noreferrer">Read article <span aria-hidden="true">↗</span></a>
						</div>
					</article>
				))}
			</div>
		</main>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=DM+Serif+Display:ital@0;1&display=swap');
	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; background: #f5f3ef; color: #20231f; font-family: 'DM Sans', sans-serif; }
	.site-header, main { width: min(1120px, calc(100% - 64px)); margin-inline: auto; }
	.site-header { display: flex; justify-content: space-between; align-items: center; padding: 28px 0; border-bottom: 1px solid #d9d8d2; }
	.nav-group { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
	.nav-right { justify-content: flex-end; }
	.site-name, nav a, .return-link, .read-link { color: inherit; text-decoration: none; }
	nav a, .eyebrow, .meta { color: #70736d; font-size: 0.74rem; letter-spacing: 0.04em; }
	nav a:hover, .return-link:hover, .read-link:hover { color: #52705d; }
	.site-name { font-size: 1rem; font-weight: 700; }
	main { padding: 54px 0 100px; }
	.return-link { display: inline-block; margin-bottom: 92px; font-size: 0.85rem; font-weight: 700; }
	.eyebrow, .meta { text-transform: uppercase; }
	h1 { margin: 0 0 64px; font-family: 'DM Serif Display', Georgia, serif; font-size: clamp(3.3rem, 7vw, 6.8rem); font-weight: 400; line-height: 0.96; }
	.article-list { border-top: 1px solid #bfc2b9; }
	article { display: flex; gap: 22px; align-items: flex-start; padding: 30px 0 36px; border-bottom: 1px solid #bfc2b9; }
	article.pinned { background: rgba(82, 112, 93, 0.04); }
	.article-cover { width: 180px; height: 120px; border-radius: 14px; object-fit: cover; object-position: center center; border: 1px solid #d5d7d2; background: #e8e7e2; }
	article.pinned .article-cover { width: 240px; height: 150px; }
	.article-content { flex: 1; display: grid; gap: 10px 32px; }
	.meta { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
	.pinned-badge { display: inline-flex; align-items: center; padding: 0.2rem 0.5rem; border-radius: 999px; background: #52705d; color: #f5f3ef; font-size: 0.62rem; letter-spacing: 0.07em; text-transform: uppercase; }
	h2 { margin: 0; font-family: 'DM Serif Display', Georgia, serif; font-size: 2rem; font-weight: 400; }
	h2 a { color: inherit; text-decoration: none; }
	h2 a:hover { color: #52705d; }
	article p { max-width: 560px; margin: 0; color: #686b65; line-height: 1.55; }
	.read-link { align-self: center; font-size: 0.8rem; font-weight: 700; white-space: nowrap; }
	.read-link span { margin-left: 5px; font-size: 1rem; }
	@media (max-width: 700px) {
		.site-header, main { width: min(100% - 40px, 560px); }
		.site-header { flex-direction: column; align-items: flex-start; }
		.nav-group { gap: 12px; }
		.nav-right { justify-content: flex-start; }
		nav a { font-size: 0.72rem; }
		main { padding-top: 34px; }
		.return-link { margin-bottom: 70px; }
		article { display: block; }
		.article-cover { width: 100%; height: 180px; margin-bottom: 18px; }
		article p { margin: 12px 0 18px; }
	}
</style>