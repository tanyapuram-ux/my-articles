---
import { featuredCompanies, featuredPublications, featuredStats, mediaMentions } from '../data/featured';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Recognition and publications featuring Tanya Puram's writing." />
    <title>Featured In | Tanya Puram</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-group nav-left" aria-label="Primary navigation">
        <a class="site-name" href="/">Home</a>
        <a href="/analytics/">Analytics</a>
        <a href="/featured/">Featured In</a>
        <a href="https://medium.com/@tanya.puram" target="_blank" rel="noopener noreferrer">Medium Blog</a>
      </nav>
      <nav class="nav-group nav-right" aria-label="Secondary navigation">
        <a href="/articles/entrepreneurship/">Entrepreneurship &amp; Business</a>
        <a href="/articles/founder-interviews/">Founder Interviews</a>
        <a href="/articles/tech-ai/">Tech &amp; AI</a>
      </nav>
    </header>

    <main>
      <a class="return-link" href="/">← Back home</a>
      <section class="hero">
        <p class="eyebrow">Selected recognition</p>
        <h1>Featured<br /><em>In.</em></h1>
        <p class="hero-copy">My work has been featured across respected publications, communities, and founder-led platforms where readers are already looking for thoughtful writing on business, leadership, and AI.</p>
      </section>

      <section class="publication-showcase" aria-label="Featured publications">
        <div class="logo-grid">
          {featuredPublications.map((publication, index) => (
            <a class="logo-link" href={publication.href} target="_blank" rel="noopener noreferrer" style={`--delay: ${index * 45}ms`} aria-label={`Visit ${publication.name}`}>
              {publication.image ? (
                <img
                  class={publication.continuous ? 'publication-image publication-image--continuous' : 'publication-image'}
                  src={publication.image}
                  alt={publication.name}
                  style={{ backgroundColor: publication.background ?? '#f4f3f0' }}
                />
              ) : (
                <span class="logo-mark" aria-hidden="true">{publication.mark}</span>
              )}
              <span class="logo-name">{publication.name}<br /><small>{publication.description}<br />{publication.audience}</small></span>
            </a>
          ))}
        </div>
      </section>

      <section class="reach-metrics" aria-label="Recognition metrics">
        <div class="reach-line">Combined audience reach: <strong>{featuredStats.combinedReach}</strong> readers</div>
        <div class="summary-card">
          <div><span>Publications featured</span><strong>{featuredStats.publicationsFeatured}</strong></div>
          <div><span>Total audience reach</span><strong>{featuredStats.combinedReach}</strong></div>
          <div><span>Articles published</span><strong>{featuredStats.articlesPublished}</strong></div>
          <div><span>Top publication</span><strong>{featuredStats.topPublication}</strong></div>
        </div>
      </section>
    </main>

    <footer>
      <span>My Articles</span>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=DM+Serif+Display:ital@0;1&display=swap');
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f5f3ef; color: #20231f; font-family: 'DM Sans', sans-serif; }
  .site-header, main, footer { width: min(1120px, calc(100% - 64px)); margin-inline: auto; }
  .site-header { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 28px 0; border-bottom: 1px solid #d9d8d2; }
  .nav-group { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .nav-right { justify-content: flex-end; }
  .site-name, nav a, .return-link { color: inherit; text-decoration: none; }
  nav a { color: #70736d; font-size: 0.74rem; letter-spacing: 0.04em; }
  nav a:hover, .return-link:hover { color: #52705d; }
  .site-name { font-size: 1rem; font-weight: 700; }
  main { padding: 54px 0 120px; }
  .return-link { display: inline-block; margin-bottom: 52px; font-size: 0.85rem; font-weight: 700; }
  .eyebrow { margin: 0 0 18px; color: #70736d; font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; }
  h1, p { margin-top: 0; }
  h1 { margin-bottom: 28px; font-family: 'DM Serif Display', Georgia, serif; font-size: clamp(3.3rem, 7vw, 7rem); font-weight: 400; line-height: 0.96; }
  h1 em { color: #52705d; }
  .hero { padding-bottom: 48px; }
  .hero-copy { max-width: 620px; color: #5f625d; font-size: 1.05rem; line-height: 1.7; }
  .publication-showcase { margin-bottom: 32px; }
  .logo-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid #bfc2b9; border-left: 1px solid #bfc2b9; }
  .logo-link { display: flex; min-height: 132px; align-items: center; gap: 14px; padding: 24px; border-right: 1px solid #bfc2b9; border-bottom: 1px solid #bfc2b9; color: #20231f; text-decoration: none; filter: none; opacity: 1; transition: opacity 180ms ease, filter 180ms ease, background 180ms ease, transform 180ms ease; animation: appear 480ms both; animation-delay: var(--delay); }
  .logo-link:hover { background: #ebeae4; transform: translateY(-3px); }
  .logo-mark { display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid #20231f; border-radius: 50%; font-size: 0.8rem; font-weight: 700; letter-spacing: -0.04em; }
  .publication-image { display: block; width: 72px; height: 72px; object-fit: contain; flex: 0 0 auto; border-radius: 12px; background: #f4f3f0; overflow: hidden; }
  .publication-image--continuous { object-fit: cover; object-position: center; width: 72px; height: 72px; border-radius: 12px; background: #24aade; transform: scale(1.06); }
  .logo-name { font-family: 'DM Serif Display', Georgia, serif; font-size: clamp(1.1rem, 2vw, 1.7rem); }
  .logo-name small { font-family: 'DM Sans', sans-serif; font-size: 0.68rem; line-height: 1.3; }
  .reach-metrics { padding-top: 12px; }
  .reach-line { margin: 0 0 24px; color: #20231f; font-size: 1.1rem; }
  .reach-line strong { color: #52705d; font-family: 'DM Serif Display', Georgia, serif; font-size: 1.9rem; font-weight: 400; }
  .summary-card { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; padding: 20px; border: 1px solid #d1d3cc; border-radius: 14px; background: rgba(255,255,255,0.34); }
  .summary-card div { display: grid; gap: 8px; }
  .summary-card span { color: #70736d; font-size: 0.64rem; letter-spacing: 0.06em; line-height: 1.35; text-transform: uppercase; }
  .summary-card strong { font-family: 'DM Serif Display', Georgia, serif; font-size: 1.5rem; font-weight: 400; }
  footer { display: flex; justify-content: space-between; padding: 28px 0 42px; color: #70736d; font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; }
  @keyframes appear { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 700px) {
    .site-header, main, footer { width: min(100% - 40px, 560px); }
    .site-header { flex-direction: column; align-items: flex-start; }
    .nav-group { gap: 12px; }
    .nav-right { justify-content: flex-start; }
    .logo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .summary-card { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
